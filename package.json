{
  "name": "@cfpb/ccdb5-ui",
  "version": "2.24.1",
  "packageManager": "yarn@4.18.0",
  "description": "Consumer Complaint Database UI",
  "homepage": "https://www.consumerfinance.gov/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfpb/ccdb5-ui.git"
  },
  "license": "CC0-1.0",
  "engines": {
    "node": ">=26.x"
  },
  "author": {
    "name": "Consumer Financial Protection Bureau",
    "email": "tech@cfpb.gov",
    "url": "https://cfpb.github.io/"
  },
  "browserslist": [
    "> 0.2% and not dead"
  ],
  "files": [
    "dist/*"
  ],
  "scripts": {
    "lint": "yarn prettier \"src/**/*.{js,jsx,ts,tsx,json,md}\" --write && yarn eslint ./src --fix && yarn stylelint \"src/**/*.{css,scss}\" --fix && yarn lint:cypress",
    "lint:cypress": "yarn eslint ./cypress --fix",
    "prepare": "husky",
    "release": "yarn run build && release-it --npm.skipChecks",
    "test": "TZ=UTC rstest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "rsbuild dev",
    "build": "./scripts/build.sh",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "@cfpb/cfpb-design-system": "5.10.3",
    "@cfpb/design-system-react": "2.0.6",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@reduxjs/toolkit": "^2.14.0",
    "dayjs": "^1.11.23",
    "history": "^5.3.0",
    "intro.js": "8.6.0",
    "lit": "^3.3.3",
    "prop-types": "^15.8.1",
    "query-string": "^10.0.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "^19.3.1",
    "react-fast-compare": "^3.2.2",
    "react-modal": "^3.16.3",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cfpb/browserslist-config": "^0.0.7",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-istanbul": "^0.12.6",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "rstest-fetch-mock": "0.1.0",
    "sass": "^1.107.1",
    "string-replace-loader": "^3.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2"
  },
  "lint-staged": {
    "src/**/*.{css,scss}": [
      "stylelint --fix"
    ],
    "{cypress,src}/**/*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "{cypress,src}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module"
}
