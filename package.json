{
  "name": "@cfpb/ccdb5-ui",
  "version": "2.21.0",
  "packageManager": "yarn@4.18.0",
  "description": "Consumer Complaint Database UI",
  "homepage": "https://www.consumerfinance.gov/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cfpb/ccdb5-ui.git"
  },
  "license": "CC0-1.0",
  "engines": {
    "node": ">=26.x"
  },
  "author": {
    "name": "Consumer Financial Protection Bureau",
    "email": "tech@cfpb.gov",
    "url": "https://cfpb.github.io/"
  },
  "browserslist": [
    "> 0.2% and not dead"
  ],
  "files": [
    "dist/*"
  ],
  "scripts": {
    "lint": "yarn prettier \"src/**/*.{js,jsx,ts,tsx,json,md}\" --write && yarn eslint ./src --fix && yarn stylelint \"src/**/*.{css,scss}\" --fix && yarn lint:cypress",
    "lint:cypress": "yarn eslint ./cypress --fix",
    "prepare": "husky",
    "release": "yarn run build && release-it --npm.skipChecks",
    "test": "TZ=UTC jest --coverage --watchAll=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "rsbuild dev",
    "build": "./scripts/build.sh",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "@cfpb/cfpb-design-system": "5.10.1",
    "@cfpb/design-system-react": "2.0.3",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "dayjs": "^1.11.23",
    "history": "^5.3.0",
    "intro.js": "7.2.0",
    "lit": "^3.3.3",
    "prop-types": "^15.8.1",
    "query-string": "^9.5.0",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "^19.2.8",
    "react-fast-compare": "^3.2.2",
    "react-modal": "^3.16.3",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@cfpb/browserslist-config": "^0.0.7",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.2.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^1.5.3",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.4.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "coveralls-next": "^6.0.2",
    "cypress": "^15.21.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.2",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^3.2.0",
    "lint-staged": "^17.3.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "release-it": "^20.2.1",
    "sass": "^1.103.1",
    "string-replace-loader": "^3.3.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "webpack": "^5.109.2"
  },
  "lint-staged": {
    "src/**/*.{css,scss}": [
      "stylelint --fix"
    ],
    "{cypress,src}/**/*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "{cypress,src}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
